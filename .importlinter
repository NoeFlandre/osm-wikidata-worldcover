[importlinter]
root_package = osm_wikidata_corine

[importlinter:contract:domain-is-pure]
name = Domain must not depend on adapters, pipeline or CLI
type = forbidden
source_modules =
    osm_wikidata_corine.domain
forbidden_modules =
    osm_wikidata_corine.adapters
    osm_wikidata_corine.pipeline
    osm_wikidata_corine.cli
    osm_wikidata_corine.config

[importlinter:contract:no-cycles]
name = No circular imports anywhere
type = independence
modules =
    osm_wikidata_corine.domain.nomenclature
    osm_wikidata_corine.domain.dominance
    osm_wikidata_corine.domain.text
    osm_wikidata_corine.domain.splits

[importlinter:contract:layers]
name = Layered architecture
type = layers
layers =
    osm_wikidata_corine.cli
    osm_wikidata_corine.pipeline
    osm_wikidata_corine.adapters
    osm_wikidata_corine.domain
